# --- DecisionTwin backend environment ---
# Local dev defaults to SQLite + in-memory cache, so all values below are optional.

# Production: postgresql+asyncpg://USER:PASS@HOST:5432/DB
DATABASE_URL=

# Production: redis://HOST:6379  (empty = in-process cache fallback)
REDIS_URL=

# Consumed by the GenAI (dt_genai) module when installed. dt_genai uses Mistral
# (open-mistral-7b). Leave MISTRAL_API_KEY empty for local dev — the copilot then
# returns a deterministic, LLM-free response instead of calling the API.
MISTRAL_API_KEY=
GENAI_MODEL=open-mistral-7b

APP_ENV=development
LOG_LEVEL=INFO

# Comma-separated allowed CORS origins (the deployed frontend URL).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
